# AgentOS configuration (copy to .env and adjust)

# API server
PORT=4000
HOST=0.0.0.0
ENVIRONMENT=production
DATABASE_PATH=./apps/api/data/agentos.db

# Session signing secret — CHANGE THIS in any real deployment
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: enable the OpenAI provider (or compatible APIs like Hugging Face, Gemini, Groq)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api-inference.huggingface.co/v1

# Optional: override the API origin the web console proxies to
# API_URL=http://localhost:4000
